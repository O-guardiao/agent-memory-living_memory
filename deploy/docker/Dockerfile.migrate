FROM golang:1.22 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/memory-migrate ./cmd/memory-migrate

FROM gcr.io/distroless/static-debian12
WORKDIR /app
COPY --from=build /out/memory-migrate /memory-migrate
COPY migrations /app/migrations
ENTRYPOINT ["/memory-migrate"]
