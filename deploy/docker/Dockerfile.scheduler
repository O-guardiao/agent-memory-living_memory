FROM golang:1.25 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/memory-scheduler ./cmd/memory-scheduler

FROM gcr.io/distroless/static-debian12
COPY --from=build /out/memory-scheduler /memory-scheduler
ENTRYPOINT ["/memory-scheduler"]
