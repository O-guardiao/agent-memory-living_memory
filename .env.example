# Agent Memory — example environment
# Copy to .env and fill in real values. NEVER commit a real .env
# (see SECURITY.md and PUBLICATION_BOUNDARY.md).

# --- Core ---
MEMORY_ENV=dev
MEMORY_PORT=8080
MEMORY_LOG_LEVEL=debug
MEMORY_DEFAULT_TENANT=tenant_demo
# "memory" (local, no infra) or "postgres_qdrant_neo4j"
MEMORY_STORAGE_MODE=memory
# "sync" or "async" (async requires the memory-worker)
MEMORY_INGESTION_MODE=sync

# --- Storage (postgres_qdrant_neo4j mode) ---
MEMORY_POSTGRES_DSN=
MEMORY_QDRANT_ENDPOINT=http://localhost:6333
MEMORY_QDRANT_COLLECTION=agent_memory
# Must match the embedding provider dimension.
MEMORY_QDRANT_VECTOR_SIZE=64
MEMORY_NEO4J_ENDPOINT=http://localhost:7474
MEMORY_NEO4J_DATABASE=neo4j
MEMORY_NEO4J_BASIC_AUTH=

# --- LLM providers (empty = heuristic distiller) ---
# anthropic | openai | local
MEMORY_LLM_PROVIDER=
MEMORY_ANTHROPIC_API_KEY=
MEMORY_ANTHROPIC_MODEL=claude-opus-4-8
MEMORY_OPENAI_API_KEY=
MEMORY_OPENAI_MODEL=gpt-4o-mini
MEMORY_LOCAL_LLM_ENDPOINT=http://localhost:11434/v1
MEMORY_LOCAL_LLM_MODEL=llama3.1

# --- Embeddings (hash = deterministic local default) ---
# hash | openai | voyage | local
MEMORY_EMBEDDING_PROVIDER=hash
MEMORY_OPENAI_EMBED_MODEL=text-embedding-3-small
MEMORY_VOYAGE_API_KEY=
MEMORY_VOYAGE_EMBED_MODEL=voyage-3.5-lite
MEMORY_LOCAL_EMBED_ENDPOINT=http://localhost:11434/v1
MEMORY_LOCAL_EMBED_MODEL=nomic-embed-text
MEMORY_EMBED_BATCH_SIZE=64
MEMORY_EMBED_MAX_RETRIES=3

# --- Reranker (simple = lexical default) ---
# simple | local | cohere | voyage
MEMORY_RERANKER_PROVIDER=simple
MEMORY_COHERE_API_KEY=
MEMORY_COHERE_RERANK_MODEL=rerank-v3.5
MEMORY_VOYAGE_RERANK_MODEL=rerank-2.5-lite

# --- Queue (empty = derived from storage mode) ---
# kafka | nats | postgres | memory
MEMORY_QUEUE_PROVIDER=
MEMORY_KAFKA_BROKERS=
MEMORY_NATS_URL=nats://localhost:4222

# --- Redis (empty = disabled) ---
MEMORY_REDIS_ADDR=
MEMORY_REDIS_PASSWORD=

# --- S3-compatible object store (empty bucket = disabled) ---
MEMORY_S3_ENDPOINT=
MEMORY_S3_REGION=us-east-1
MEMORY_S3_BUCKET=
MEMORY_S3_ACCESS_KEY=
MEMORY_S3_SECRET_KEY=
MEMORY_S3_PATH_STYLE=true

# --- Security (empty = disabled) ---
# base64-encoded 32-byte key for envelope encryption
MEMORY_ENCRYPTION_KEY=
# "key" or "key:tenant_id", comma-separated; empty = auth off
MEMORY_API_KEYS=
MEMORY_RATE_LIMIT_RPS=0
MEMORY_RATE_LIMIT_BURST=0

# --- Feature flags (default off = MVP behavior) ---
MEMORY_CONSOLIDATION_ENABLED=false
MEMORY_PRIVACY_GATES_ENABLED=false
MEMORY_EVAL_RECORDER_ENABLED=false

# --- Scheduler ---
MEMORY_SCHEDULER_RETENTION_INTERVAL=1m
MEMORY_SCHEDULER_REINDEX_INTERVAL=10m
MEMORY_SCHEDULER_COMPACT_INTERVAL=5m
MEMORY_SCHEDULER_JOBS_RETENTION=168h

# --- Telemetry ---
MEMORY_OTLP_ENDPOINT=

# --- CLI ---
MEMORY_BASE_URL=http://localhost:8080
MEMORY_API_KEY=
MEMORY_TENANT=tenant_demo

# --- Living Memory v2 engine (Python / MCP) ---
# Storage root for the local engine vault (keep OUT of git).
LIVING_MEMORY_ROOT=.living_memory_vault
# 1 = compact MCP tool descriptors (fewer tokens per session).
LIVING_MEMORY_COMPACT_TOOLS=1
